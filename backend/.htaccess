# Configuracion Backend Apache para IPEM 349 (Apache 2.4)
Options -Indexes
DirectoryIndex index.php

# Pasar el header Authorization a PHP (necesario con mod_php/CGI/FastCGI)
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# CORS se resuelve en PHP (config/cors.php) con lista blanca.

# Ocultar archivos sensibles
<FilesMatch "^(\.|config\.local\.php$)">
    Require all denied
</FilesMatch>

# Nunca mostrar errores PHP en la respuesta (se registran en el log). Evita que un aviso
# anterior al script (p. ej. cuerpo mayor que post_max_size) rompa el JSON.
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag html_errors off
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors off
    php_flag html_errors off
</IfModule>
